<?xml version="1.0" encoding="UTF-8"?>
<!-- Two <geoReference> definitions. OpenDRIVE 8.5 forbids more than one
     (asam.net:xodr:1.9.0:header.proj.max_one_proj); the first wins and the
     rest are reported and ignored. -->
<OpenDRIVE>
  <header revMajor="1" revMinor="8" name="bad_header_two_georeference" vendor="RoadMaker">
    <geoReference><![CDATA[+proj=tmerc +lat_0=1 +lon_0=2 +k=1 +x_0=0 +y_0=0]]></geoReference>
    <geoReference><![CDATA[+proj=utm +zone=9 +datum=WGS84]]></geoReference>
  </header>
  <road name="r" length="50" id="1" junction="-1">
    <planView>
      <geometry s="0" x="0" y="0" hdg="0" length="50"><line /></geometry>
    </planView>
    <lanes>
      <laneSection s="0">
        <center><lane id="0" type="none" level="false" /></center>
        <right>
          <lane id="-1" type="driving" level="false">
            <width sOffset="0" a="3.5" b="0" c="0" d="0" />
          </lane>
        </right>
      </laneSection>
    </lanes>
  </road>
</OpenDRIVE>
