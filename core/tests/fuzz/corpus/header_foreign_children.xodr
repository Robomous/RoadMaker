<?xml version="1.0" encoding="UTF-8"?>
<!-- A <header> full of things RoadMaker does not model: a <license> (6.4.2),
     a foreign <userData>, and unknown attributes. All of it is preserved
     verbatim and re-emitted (p7-s5 #324 / fmt-f1 #453) rather than dropped,
     which is what the parser-never-silently-drops rule requires. -->
<OpenDRIVE>
  <header revMajor="1" revMinor="9" name="header_foreign_children" vendor="SomeoneElse"
          date="2026-07-28T10:00:00" version="1.00" north="1" south="-1" east="60" west="-1">
    <geoReference><![CDATA[+proj=utm +zone=31 +ellps=GRS80 +units=m +no_defs]]></geoReference>
    <offset x="448000" y="5411000" z="0" hdg="0" />
    <license name="CC BY 4.0" spdxid="CC-BY-4.0" resource="https://creativecommons.org/licenses/by/4.0/" />
    <userData code="acme:survey">crew 7</userData>
  </header>
  <road name="r" length="50" id="1" junction="-1">
    <planView>
      <geometry s="0" x="0" y="0" hdg="0" length="50"><line /></geometry>
    </planView>
    <lanes>
      <laneSection s="0">
        <center><lane id="0" type="none" level="false" /></center>
        <right>
          <lane id="-1" type="driving" level="false">
            <width sOffset="0" a="3.5" b="0" c="0" d="0" />
          </lane>
        </right>
      </laneSection>
    </lanes>
  </road>
</OpenDRIVE>
