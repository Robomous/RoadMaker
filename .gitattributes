# The in-app help stylesheet is generated by help_style::css() (LF output) and
# compared byte-for-byte against the committed copy by the CssMatchesCommittedHelpCss
# gate. Force LF on checkout so the Windows runner (autocrlf) matches the generator.
editor/resources/help/help.css text eol=lf

# Same class of gate, second instance (p8-s1, #245): the tracked scenario fixture
# is what osc::write_xosc emits, and XoscFixture.TheTrackedScenarioIsExactlyWhat
# TheWriterEmitsToday compares it byte for byte. The writer emits '\n' and the
# test reads in binary, so without this the Windows runner's autocrlf checkout
# fails the gate on line endings alone — which is exactly how it first failed.
tests/esmini/*.xosc text eol=lf
