imgui.ini

# Local Claude Code config (never committed)
CLAUDE.md
.claude/

# Graphipy
graphify-out/

# ASAM spec references now live in third_party/asam/ and are TRACKED, so a
# fresh clone or worktree has them (they used to sit under the gitignored
# `.claude/`, where a grep returned nothing rather than an error).
#
# OpenDRIVE is committed: it carries its own unrestricted licence grant.
# OpenSCENARIO is NOT, and must not be — it has no comparable grant, so
# publishing it would hand it to readers with no licence to receive it.
# Rationale and the quoted terms: third_party/asam/README.md.
third_party/asam/openscenario-*/

# Diagnostic evidence (renders, glb dumps) belongs in issues/PRs, never in
# the repo (docs/contributing/pull-requests.md).
diag/

# gw1_replay.py / gw2_replay.py generated artifacts
gw1_replay_out/
gw2_replay_out/

# The scale bench writes its measurements beside the binary it runs from.
scale-metrics.json
docs-site/dist/
docs-site/node_modules/
docs-site/.astro/
